# Copy to `.env` for local development. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Backend origin for the Global Ducan REST API (no trailing slash, no /api/v1).
# ---------------------------------------------------------------------------
# Production API (default). Works for local dev too — the Vite dev server
# proxies /api to this host, so there are no CORS issues.
VITE_API_BASE=https://app.globalducan.com

# To develop against a local/LAN backend instead, override it, e.g.:
#   VITE_API_BASE=http://192.168.1.19:15000
# An http:// host is fine in dev (requests go through the Vite proxy).
#
# PRODUCTION (e.g. Vercel) — set VITE_API_BASE in the project's Environment
# Variables. The build then calls it directly:
#   https://app.globalducan.com/api/v1/auth/signin
#
# NOTE: a browser on an HTTPS page cannot call an http:// API (mixed content),
# so a private/LAN address will NOT work on a deployed site. If your API is
# HTTP-only, leave VITE_API_BASE unset and proxy same-origin instead by adding
# this to vercel.json ABOVE the SPA catch-all rewrite:
#   { "source": "/api/:path*", "destination": "http://your-api-host/api/:path*" }

# Public web origin, used to build referral links.
VITE_WEB_URL=https://my.globalducan.com
