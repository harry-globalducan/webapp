# Copy to `.env` for local development. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Backend origin for the Global Ducan REST API (no trailing slash, no /api/v1).
# ---------------------------------------------------------------------------
# LOCAL DEV
#   The browser always calls same-origin `/api/v1/*` and the Vite dev server
#   proxies to this host, so an http:// LAN address is fine here.
VITE_API_BASE=http://192.168.1.19:15000

# PRODUCTION (e.g. Vercel) — set this in the project's Environment Variables.
# Two supported setups:
#
#   A) Direct calls (requires the API to be reachable over HTTPS + CORS):
#        VITE_API_BASE=https://api.globalducan.com
#      The client then calls https://api.globalducan.com/api/v1/auth/signin
#
#   B) Same-origin proxy (use when the API is HTTP-only or you want to avoid
#      CORS): leave VITE_API_BASE UNSET so requests stay relative, and add an
#      /api rewrite to vercel.json:
#        { "source": "/api/:path*", "destination": "https://api.globalducan.com/api/:path*" }
#      Put that entry BEFORE the SPA catch-all rewrite.
#
# NOTE: a browser on an HTTPS page cannot call an http:// API (mixed content),
# so pointing VITE_API_BASE at http://192.168.1.19:15000 will NOT work on Vercel.

# Public web origin, used to build referral links.
VITE_WEB_URL=https://my.globalducan.com
